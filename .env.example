# ─────────────────────────────────────────────────────────────
# Flight Study Tracker: configuration
# Copy this file to ".env" and fill in your key.
# The .env file stays on your computer. Never commit it.
# ─────────────────────────────────────────────────────────────

# Your AirLabs API key (https://airlabs.co → Sign up → Dashboard → API key)
AIRLABS_API_KEY=

# Port for the local web server (open http://localhost:3000)
PORT=3000

# Which network interface to listen on.
# 127.0.0.1 = only this computer (safest).
# 0.0.0.0   = also reachable from your phone on the same Wi-Fi.
HOST=127.0.0.1

# How often (seconds) the page asks for fresh data while a flight is airborne.
# Each refresh usually costs 1 AirLabs request (sometimes 2). Allowed: 30–600.
REFRESH_INTERVAL_SECONDS=60

# Flight data provider. Only "airlabs" ships with this project.
FLIGHT_PROVIDER=airlabs

# Optional password for the whole site. Leave empty on your own computer.
# Set it when the app is online (e.g. on Render) so strangers can't use your
# AirLabs requests. The browser asks for it once; any user name works.
SITE_PASSWORD=

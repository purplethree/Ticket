# ─────────────────────────────────────────────────────────────
# Flight Study Tracker: configuration
# Copy this file to ".env" and fill in your key.
# The .env file stays on your computer. Never commit it.
# (On Render, set these under your service → Environment instead.)
# ─────────────────────────────────────────────────────────────

# Flight data provider: "aerodatabox" (default) or "airlabs".
FLIGHT_PROVIDER=aerodatabox

# AeroDataBox key from RapidAPI (rapidapi.com → AeroDataBox → subscribe to the
# free Basic plan → copy the X-RapidAPI-Key value).
AERODATABOX_API_KEY=

# Only if you use AirLabs instead (FLIGHT_PROVIDER=airlabs).
AIRLABS_API_KEY=

# Port for the local web server (open http://localhost:3000)
PORT=3000

# Which network interface to listen on.
# 127.0.0.1 = only this computer (safest).
# 0.0.0.0   = also reachable from your phone on the same Wi-Fi.
HOST=127.0.0.1

# How often (seconds) the page asks for fresh data while a flight is airborne.
# Each refresh costs 1 AeroDataBox unit (free plan: 600 units a month).
# 120 s ≈ 180 units for a 6-hour flight. Allowed: 30–600.
REFRESH_INTERVAL_SECONDS=120

# Optional password for the whole site. Leave empty on your own computer.
# Set it when the app is online (e.g. on Render) so strangers can't use your
# API allowance. The browser asks for it once; any user name works.
SITE_PASSWORD=
